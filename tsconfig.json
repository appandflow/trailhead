{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "customConditions": ["react-native", "react-native-legacy-deep-imports"],
    "paths": {
      "@/*": [
        "./*"
      ],
      "react-native-screen-transitions": [
        "./node_modules/react-native-screen-transitions/lib/typescript/index.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
